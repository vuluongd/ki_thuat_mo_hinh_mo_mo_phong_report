FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [turbulentViscosity];

internalField   uniform 6e-6;

boundaryField
{
    inlet
    {
        type            freestream;
        freestreamValue uniform 6e-6;
    }

    outlet
    {
        type            freestream;
        freestreamValue uniform 6e-6;
    }

    walls
    {
        type            nutUSpaldingWallFunction;
        value           uniform 0;
    }

    frontAndBack
    {
        type            empty;
    }
}

